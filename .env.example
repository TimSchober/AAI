OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# In Docker:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Arbeitsagentur Jobsuche API:
JOBSUCHE_API_KEY=jobboerse-jobsuche
JOBSUCHE_API_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service

# Jobsuche microservice.
JOBSUCHE_SERVICE_URL=
JOBSUCHE_SERVICE_PORT=8100

# Company research.
# Wikipedia, Wikidata and OpenStreetMap are used without any key.
# BRAVE_API_KEY is optional and only adds the web/news search on top.
BRAVE_API_KEY=
COMPANY_RESEARCH_LANG=de
COMPANY_RESEARCH_TIMEOUT=30

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Flask backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_CORS_ORIGINS=*
AGENT_TIMEOUT=300

# Chat image attachments
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif

# Vue frontend (nginx).
FRONTEND_PORT=8080
MAX_BODY_SIZE=12m

# RAG storage (ChromaDB).
CHROMA_HOST=
CHROMA_PORT=8200
CHROMA_COLLECTION=bewerbungsunterlagen
EMBED_MODEL=all-MiniLM-L6-v2

DOCS_DIR=./ChromaDB/docs
UPLOAD_DIR=./ChromaDB/uploads
