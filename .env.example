# Ollama LLM:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# In Docker:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Arbeitsagentur Jobsuche API:
JOBSUCHE_API_KEY=jobboerse-jobsuche # (public available key (no secret))
JOBSUCHE_API_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service

# Jobsuche microservice.
# Empty -> the MCP server calls the Arbeitsagentur API directly, in-process.
# Set   -> the MCP server routes job board calls through the service.
JOBSUCHE_SERVICE_URL=
JOBSUCHE_SERVICE_PORT=8100

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Flask backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_CORS_ORIGINS=*
AGENT_TIMEOUT=300

# RAG storage (ChromaDB).
# CHROMA_HOST empty -> embedded on-disk store at CHROMA_DB_PATH.
# CHROMA_HOST set   -> standalone Chroma server (the `rag` container).
CHROMA_HOST=
CHROMA_PORT=8200
CHROMA_COLLECTION=bewerbungsunterlagen
EMBED_MODEL=all-MiniLM-L6-v2

DOCS_DIR=./ChromaDB/docs
