FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    JOBSUCHE_SERVICE_HOST=0.0.0.0 \
    JOBSUCHE_SERVICE_PORT=8100

WORKDIR /app

COPY docker/requirements/jobsuche.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py __init__.py ./
COPY core_functions/__init__.py ./core_functions/
COPY core_functions/arbeitsagentur_jobsuche_API_jobs_client.py ./core_functions/
COPY services/ ./services/

RUN mkdir -p /app/runtime

RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8100/health')"

CMD ["gunicorn", "--bind", "0.0.0.0:8100", \
     "--workers", "2", "--threads", "4", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "services.jobsuche_api.app:create_app()"]
